<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>br.uea.tcc2</groupId>
  <artifactId>jade-agents</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>TCC2 ECA/BDI agents (JADE + BDI4JADE)</name>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <repositories>
    <!-- BDI4JADE não está no Maven Central; o JitPack constrói a partir do
         GitHub. CONFIRME o coordinate/tag em https://github.com/ingridnunes/bdi4jade
         (ou faça `git clone` + `mvn install` e ajuste a dependência abaixo). -->
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- JADE (FIPA): agentes, FIPA-ACL, FIPA Contract Net, O2A.
         Este coordinate (repackaging do JADE 4.3.3) resolve no Maven Central e
         foi VERIFICADO: compila + roda no JDK 17 (JADE 4.3.3, rev. 2014). O
         JADE oficial (jade.tilab.com) pode ser usado no lugar via install local
         se você quiser uma versão mais nova. -->
    <dependency>
      <groupId>net.sf.ingenias</groupId>
      <artifactId>jade</artifactId>
      <version>4.3</version>
    </dependency>

    <!-- JSON de fio (mesmo formato do bridge/PROTOCOL.md) -->
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
      <version>20231013</version>
    </dependency>

    <!-- commons-logging: exigido pelo BDI4JADE em tempo de compilação/execução -->
    <dependency>
      <groupId>commons-logging</groupId>
      <artifactId>commons-logging</artifactId>
      <version>1.2</version>
    </dependency>

    <!-- BDI4JADE (Ingrid Nunes) -- a MESMA plataforma do BDI2DoS. Não está no
         Maven Central; usamos o jar já construído em libs/ (ver libs/README.md).
         Alternativa validada e mais simples: ./build.sh (javac, sem Maven). -->
    <dependency>
      <groupId>br.ufrgs.inf</groupId>
      <artifactId>bdi4jade</artifactId>
      <version>local</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/libs/bdi4jade.jar</systemPath>
    </dependency>
  </dependencies>

  <build>
    <finalName>jade-agents</finalName>
    <plugins>
      <!-- jar executável com dependências (uber-jar) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>br.uea.tcc2.agents.Launcher</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
